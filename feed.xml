---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | append: ' — Essays' | xml_escape }}</title>
    <link>{{ '/essays/' | absolute_url | xml_escape }}</link>
    <description>{{ site.description | xml_escape }}</description>
    <language>en</language>
    <atom:link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    {% assign sorted_essays = site.essays | sort: 'date' | reverse %}
    {% for essay in sorted_essays %}
    <item>
      <title>{{ essay.title | xml_escape }}</title>
      <link>{{ essay.url | absolute_url | xml_escape }}</link>
      <guid isPermaLink="true">{{ essay.url | absolute_url | xml_escape }}</guid>
      <pubDate>{{ essay.date | date_to_rfc822 }}</pubDate>
      <description>{{ essay.description | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
